[Unit]
Description=Rotations production ingestion through isolated exit node

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
ExecStartPre=/usr/bin/bash scripts/waitProductionRuntime.sh
ExecStart=/usr/bin/sg docker -c "/usr/bin/docker exec --user 1000:1000 rotations-ingestion-production setsid --wait bash scripts/runProductionDirect.sh"
ExecStop=/usr/bin/sg docker -c "/usr/bin/docker exec --user 1000:1000 rotations-ingestion-production node scripts/stopProductionRun.mjs"
ExecStartPost=/usr/bin/systemctl --user --no-block start rotations-production-email.service
UMask=0077
TimeoutStartSec=15min
Restart=on-failure
RestartSec=5min
RestartPreventExitStatus=75
TimeoutStopSec=15s
