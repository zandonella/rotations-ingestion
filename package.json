{
    "name": "mythic-shop-api",
    "version": "1.0.0",
    "description": "API to call locally with the league client open to get the mythic shop offerings and send data to web server",
    "main": "parse.js",
    "scripts": {
        "prod:process:static": "node --env-file=.env.prod processStaticData.ts",
        "prod:process:client": "node --env-file=.env.prod processClientData.ts",
        "test": "node tests/catalogSales.test.ts && node tests/yourShop.test.ts && node tests/leagueLockfile.test.ts && node --experimental-test-module-mocks --test tests/refreshPublicApi.test.ts tests/refreshHintFlow.test.ts",
        "local:collect": "node scripts/localRun.mjs collect",
        "local:client": "node scripts/localRun.mjs client",
        "local:process:client": "node scripts/localRun.mjs process-client",
        "local:direct": "node scripts/localRun.mjs direct",
        "local:collect:direct": "node scripts/localRun.mjs collect-direct",
        "local:static": "node scripts/localRun.mjs static",
        "test:linux": "node --test tests/linuxCollector.test.mjs",
        "test:local-db": "node tests/localDatabaseSmoke.mjs"
    },
    "type": "module",
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@supabase/supabase-js": "^2.90.1",
        "dotenv": "^17.2.3"
    },
    "devDependencies": {
        "supabase": "^2.100.0"
    },
    "engines": {
        "node": ">=22.18.0"
    }
}
